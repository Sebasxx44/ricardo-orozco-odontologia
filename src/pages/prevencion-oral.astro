---
import PageLayoutTA from "@/components/PageLayoutTA.astro";
import ActionHeaderTA from "@/components/ActionHeaderTA.astro";
import ContactBandTA from "@/components/ContactBandTA.astro";
import FaqTA from "@/components/FaqTA.astro";
import IconTA from "@/components/IconTA.astro";

const pillars = [
  { icon: "heart", number: "01", title: "Educación y orientación", text: "Entender tu salud oral es parte del cuidado. Recibe orientación personalizada y consulta las dudas sobre tus hábitos de higiene." },
  { icon: "shield", number: "02", title: "Detección temprana", text: "La valoración y los controles permiten identificar necesidades de atención antes de que pasen inadvertidas por más tiempo." },
  { icon: "tooth", number: "03", title: "Controles y limpieza", text: "Las revisiones y limpiezas profesionales forman parte de la prevención. Su frecuencia se establece según las necesidades de cada paciente." },
];
---
<PageLayoutTA title="Prevención oral en Pereira" description="Educación, diagnóstico temprano, controles y limpieza profesional. Conoce el enfoque de prevención oral del Dr. Ricardo Orozco en Pereira." active="prevencion-oral">
  <section class="prevention-hero section-shell"><div class="prevention-copy reveal"><p class="eyebrow">PREVENCIÓN ORAL</p><h1>Cuidar hoy.<br /><span>Conservar mañana.</span></h1><p>La salud oral se construye con hábitos, controles y orientación profesional. Una valoración permite reconocer qué cuidados necesita tu sonrisa.</p><a href="/contacto" class="button button-dark">Hablemos de prevención <IconTA name="arrow" size={18} /></a><div class="prevention-note"><IconTA name="check" size={18} /><span>Orientación adaptada a cada paciente.</span></div></div><div class="prevention-visual reveal"><img src="/images/dental-scan.webp" srcset="/images/dental-scan-480.webp 480w, /images/dental-scan-960.webp 960w, /images/dental-scan-1600.webp 1600w" sizes="(max-width:650px) 88vw, 43vw" width="960" height="720" alt="Imagen de diagnóstico y cuidado odontológico" fetchpriority="high" /><span class="care-label"><IconTA name="shield" size={22} /><span>EL CUIDADO TAMBIÉN EMPIEZA<br /><strong>antes de una molestia.</strong></span></span></div></section>
  <section class="pillars-section section-shell"><ActionHeaderTA level="h2" eyebrow="UN CUIDADO QUE TE ACOMPAÑA" title="Pequeñas decisiones. Cuidado continuo." description="La prevención combina educación, revisión clínica y orientación individual." /><div class="pillars-grid">{pillars.map((pillar) => <article class="pillar-card reveal"><div class="pillar-heading"><IconTA name={pillar.icon} size={31} /><span>{pillar.number}</span></div><h3>{pillar.title}</h3><p>{pillar.text}</p></article>)}</div></section>
  <section class="daily-care section-shell"><div class="daily-heading"><p class="eyebrow">SALUD ORAL EN TU VIDA DIARIA</p><h2>No es solo una sonrisa.<br /><span>Es parte de tu día a día.</span></h2></div><div class="daily-copy"><p>Los dientes intervienen en la masticación, la alimentación, la fonación y la apariencia del rostro. Cuidarlos también es cuidar estas funciones.</p><ul><li><IconTA name="check" size={18} /><span>Masticación y alimentación.</span></li><li><IconTA name="check" size={18} /><span>Fonación.</span></li><li><IconTA name="check" size={18} /><span>Estética facial.</span></li></ul><p>En el consultorio promovemos el cuidado bucal a través de la educación y la detección temprana, con orientación acorde con cada caso.</p></div></section>
  <FaqTA />
  <ContactBandTA />
</PageLayoutTA>
<style>
  .prevention-hero{display:grid;grid-template-columns:1.05fr 1fr;align-items:center;gap:9%;padding-block:75px 85px}.prevention-copy h1{font-size:clamp(39px,4.6vw,67px);font-weight:600;line-height:1.1;letter-spacing:-2.8px;color:#193f50;margin:25px 0}.prevention-copy h1 span{color:#7c9bab}.prevention-copy>p:not(.eyebrow){font-size:15px;line-height:1.85;color:#5f7480;max-width:440px;margin-bottom:29px}.prevention-copy .button{font-size:13px}.prevention-note{display:flex;align-items:center;gap:10px;margin-top:30px;font-size:12px;color:#5f7480}.prevention-note>svg{color:#77a3bd}.prevention-visual{position:relative;height:450px;border-radius:120px 12px 12px 12px;overflow:hidden;background:#ebf2f5}.prevention-visual>img{height:100%;width:100%;object-fit:cover}.care-label{position:absolute;left:25px;right:25px;bottom:24px;display:flex;align-items:center;gap:14px;padding:19px;background:#ffffffed;border-radius:8px;backdrop-filter:blur(10px);color:#193f50}.care-label>svg{color:#7eacc5;flex-shrink:0}.care-label>span{font-size:10px;letter-spacing:.07em;line-height:1.7}.care-label strong{font-weight:500;font-size:14px;letter-spacing:0}.pillars-section{padding-block:60px 80px;border-top:1px solid #dfe6e9}.pillars-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:25px;margin-top:38px}.pillar-card{padding:30px 27px;border-top:1px solid #d8e4e9;background:linear-gradient(180deg,#f2f7f9,transparent);border-radius:7px}.pillar-heading{display:flex;align-items:center;justify-content:space-between;color:#7eabc6;margin-bottom:32px}.pillar-heading>span{font-size:12px;color:#9fb3be}.pillar-card h3{font-size:21px;font-weight:500;line-height:1.4;letter-spacing:-.6px;color:#193f50;margin:0 0 16px}.pillar-card>p{font-size:14px;line-height:1.85;color:#5f7480}.daily-care{display:grid;grid-template-columns:1fr 1fr;gap:10%;background:#f0f5f7;border-radius:12px;padding-block:55px;margin-block:15px 70px}.daily-heading h2{font-size:clamp(30px,3.3vw,46px);font-weight:500;letter-spacing:-1.5px;line-height:1.15;color:#193f50;margin-top:22px}.daily-heading h2 span{color:#7e9dac}.daily-copy>p{font-size:14px;line-height:1.85;color:#5f7480}.daily-copy ul{list-style:none;padding:0;margin:24px 0}.daily-copy li{display:flex;gap:11px;align-items:center;font-size:13px;color:#496d80;margin-bottom:14px}.daily-copy li>svg{color:#7eab91;flex-shrink:0}
  @media(max-width:950px){.prevention-hero{gap:6%;padding-block:50px 65px}.prevention-copy h1{font-size:44px;letter-spacing:-1.8px}.prevention-copy>p:not(.eyebrow){font-size:14px}.prevention-visual{height:400px}.care-label{left:18px;right:18px;padding:16px;gap:11px}.care-label>span{font-size:8px}.care-label strong{font-size:12px}.pillars-grid{gap:18px}.pillar-card{padding:27px 21px}.pillar-card h3{font-size:19px}.pillar-card>p{font-size:13px}.daily-care{gap:7%;padding-block:40px}.daily-heading h2{font-size:33px}.daily-copy>p{font-size:13px}}
  @media(max-width:650px){.prevention-hero{grid-template-columns:1fr;gap:34px;padding-block:42px 55px}.prevention-copy h1{font-size:43px;letter-spacing:-1.7px;margin-top:21px}.prevention-copy>p:not(.eyebrow){font-size:15px}.prevention-note{font-size:12px;gap:9px;margin-top:26px}.prevention-visual{height:350px;border-top-left-radius:90px}.care-label{left:19px;right:19px;bottom:19px;padding:17px;gap:13px}.care-label>span{font-size:9px}.care-label strong{font-size:13px}.pillars-section{padding-block:48px 55px}.pillars-grid{grid-template-columns:1fr;gap:22px;margin-top:29px}.pillar-card{padding:27px 24px}.pillar-heading{margin-bottom:25px}.pillar-card h3{font-size:23px}.pillar-card>p{font-size:14px}.daily-care{grid-template-columns:1fr;gap:27px;padding-block:35px;margin-block:0 50px}.daily-heading h2{font-size:35px;letter-spacing:-1px}.daily-copy>p{font-size:14px}.daily-copy li{font-size:14px}}
</style>

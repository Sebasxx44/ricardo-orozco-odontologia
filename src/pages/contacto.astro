---
import PageLayoutTA from "@/components/PageLayoutTA.astro";
import ContactFormTA from "@/components/ContactFormTA.astro";
import IconTA from "@/components/IconTA.astro";
import FaqTA from "@/components/FaqTA.astro";
import { practice } from "@/data/practice";

const mapsUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent("Mega Centro Pinares Carrera 18 12-75 Pereira Risaralda")}`;
---
<PageLayoutTA title="Contacto y citas en Pereira" description="Solicita tu cita con el Dr. Ricardo Orozco. Mega Centro Pinares, Torre 1, consultorio 904, Pereira. Atención por WhatsApp y correo electrónico." active="contacto">
  <section class="contact-heading section-shell reveal"><p class="eyebrow">CONVERSEMOS SOBRE TU SALUD ORAL</p><h1>Tu próxima consulta<br /><span>empieza aquí.</span></h1><p>Déjanos conocer el motivo de tu solicitud. El equipo del consultorio podrá orientarte sobre la atención y la disponibilidad.</p></section>
  <section class="contact-main section-shell"><div class="contact-form-column reveal"><ContactFormTA /></div><aside class="contact-aside reveal" aria-label="Información de contacto"><div class="location-card"><span class="contact-icon"><IconTA name="pin" size={26} /></span><p class="eyebrow">ENCUÉNTRANOS EN PEREIRA</p><h2>Un espacio para<br />cuidar de tu sonrisa.</h2><address>Carrera 18 No. 12-75<br />Mega Centro Pinares<br />Torre 1 · Consultorio 904<br />Pereira, Risaralda</address><a href={mapsUrl} target="_blank" rel="noreferrer" class="text-link">Ver ubicación <IconTA name="arrow" size={17} /></a></div><div class="contact-lines"><div><span class="line-icon"><IconTA name="whatsapp" size={22} /></span><div><p>WhatsApp</p><a href={`https://wa.me/${practice.whatsapp}`} target="_blank" rel="noreferrer">{practice.phone}</a></div></div><div><span class="line-icon"><IconTA name="phone" size={21} /></span><div><p>Contacto alterno</p><a href="tel:+573118417498">{practice.alternatePhones[0]}</a></div></div><div><span class="line-icon"><IconTA name="phone" size={21} /></span><div><p>Teléfono fijo</p><span class="fixed-phone">{practice.alternatePhones[1]}</span></div></div><div><span class="line-icon"><IconTA name="mail" size={21} /></span><div><p>Correo electrónico</p><a href={`mailto:${practice.email}`} class="email-link">{practice.email}</a></div></div></div><div class="social-card"><p>También puedes encontrarnos en</p><a href={practice.instagram} target="_blank" rel="noreferrer"><IconTA name="instagram" size={18} /><span>Instagram del consultorio</span><IconTA name="arrow" size={15} /></a><a href={practice.alternateInstagram} target="_blank" rel="noreferrer"><IconTA name="instagram" size={18} /><span>Instagram del doctor</span><IconTA name="arrow" size={15} /></a><a href={practice.facebook} target="_blank" rel="noreferrer"><IconTA name="facebook" size={18} /><span>Facebook</span><IconTA name="arrow" size={15} /></a></div><p class="availability-note"><IconTA name="calendar" size={18} />Confirma la disponibilidad al solicitar tu cita.</p></aside></section>
  <FaqTA />
</PageLayoutTA>
<style>
  .contact-heading{padding-block:65px 45px}.contact-heading h1{font-size:clamp(41px,4.8vw,69px);font-weight:600;line-height:1.1;letter-spacing:-2.8px;color:#193f50;margin:24px 0}.contact-heading h1 span{color:#7a9aa9}.contact-heading>p:last-child{font-size:15px;line-height:1.85;color:#5f7480;max-width:550px}.contact-main{display:grid;grid-template-columns:1.35fr 1fr;gap:8%;padding-block:10px 85px;align-items:start}.contact-aside{padding-top:2px}.location-card{padding:31px;background:#edf4f7;border-radius:11px;border:1px solid #e0eaee}.contact-icon{height:53px;width:53px;display:grid;place-items:center;border-radius:12px;background:#e3edf4;color:#6b9fbc;margin-bottom:25px}.location-card .eyebrow{font-size:10px;color:#6d8c9d;letter-spacing:.1em}.location-card h2{font-size:26px;letter-spacing:-.7px;line-height:1.3;font-weight:500;color:#193f50;margin:17px 0 22px}.location-card address{font-size:14px;line-height:1.95;font-style:normal;color:#5f7480}.location-card .text-link{margin-top:23px;font-size:13px;display:flex;justify-content:space-between;align-items:center}.contact-lines{margin-top:31px}.contact-lines>div{display:flex;align-items:flex-start;gap:16px;padding:18px 0;border-bottom:1px solid #e1e8eb}.line-icon{width:26px;color:#83a9bd;padding-top:4px;flex-shrink:0}.contact-lines>div>div{min-width:0}.contact-lines p{font-size:12px;color:#5f7480;margin-bottom:8px}.contact-lines a,.fixed-phone{font-size:15px;color:#345d73;line-height:1.6}.contact-lines a:hover{text-decoration:underline;text-underline-offset:4px}.email-link{font-size:13px!important;overflow-wrap:anywhere}.social-card{margin-top:30px}.social-card>p{font-size:12px;color:#5f7480;margin-bottom:19px}.social-card>a{display:flex;align-items:center;gap:11px;margin-bottom:18px;font-size:13px;color:#436f87}.social-card>a>svg:first-child{color:#80a8c0;flex-shrink:0}.social-card>a>svg:last-child{margin-left:auto;color:#83a7bc;flex-shrink:0}.availability-note{display:flex;align-items:flex-start;gap:11px;font-size:12px;line-height:1.8;color:#5f7480;background:#f3f6f7;padding:17px;border-radius:8px;margin-top:25px}.availability-note>svg{color:#8cacc0;flex-shrink:0;margin-top:2px}
  @media(max-width:950px){.contact-main{grid-template-columns:1.15fr 1fr;gap:5%}.location-card{padding:26px}.location-card h2{font-size:23px}.location-card address{font-size:13px}.contact-heading h1{font-size:50px;letter-spacing:-1.9px}.contact-lines{margin-top:25px}.contact-lines>div{gap:12px}.contact-lines a,.fixed-phone{font-size:14px}.email-link{font-size:12px!important}}
  @media(max-width:650px){.contact-heading{padding-block:42px 35px}.contact-heading h1{font-size:43px;letter-spacing:-1.7px;margin-block:21px}.contact-heading>p:last-child{font-size:15px}.contact-main{grid-template-columns:1fr;gap:33px;padding-bottom:55px}.location-card{padding:29px}.location-card h2{font-size:28px}.location-card address{font-size:15px}.location-card .eyebrow{font-size:10px}.location-card .text-link{font-size:14px}.contact-lines a,.fixed-phone{font-size:16px}.email-link{font-size:14px!important}.contact-lines p{font-size:13px}.contact-lines>div{gap:16px;padding-block:20px}.social-card>p{font-size:13px}.social-card>a{font-size:14px;margin-bottom:21px}.availability-note{font-size:12px;margin-top:27px}}
</style>

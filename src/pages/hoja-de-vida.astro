---
import PageLayoutTA from "@/components/PageLayoutTA.astro";
import ActionHeaderTA from "@/components/ActionHeaderTA.astro";
import ContactBandTA from "@/components/ContactBandTA.astro";
import IconTA from "@/components/IconTA.astro";
import { education, practice, studies } from "@/data/practice";

const publishedFigures = [
  { value: "+10", label: "Años de experiencia" },
  { value: "+1000", label: "Sonrisas transformadas" },
  { value: "98%", label: "Satisfacción de clientes" },
  { value: "100%", label: "Tecnología digital" },
];
---
<PageLayoutTA title="Hoja de vida" description="Conoce la formación del Dr. Ricardo Orozco: odontólogo CES y especialista en Rehabilitación Oral Integral de la Universidad Autónoma de Manizales, en Pereira." active="hoja-de-vida">
  <section class="profile-hero section-shell">
    <div class="profile-copy reveal"><p class="eyebrow">LA PERSONA DETRÁS DE TU ATENCIÓN</p><h1>Conocimiento clínico.<br /><span>Trato cercano.</span></h1><p class="profile-intro">Dr. Ricardo Orozco</p><p class="profile-role">Odontólogo y especialista en Rehabilitación Oral Integral.</p><p>Una atención que empieza por escucharte, explicar cada procedimiento y entender las necesidades de tu salud oral.</p><a href="/contacto" class="button button-dark">Conversemos sobre tu salud oral <IconTA name="arrow" size={18} /></a><div class="membership"><IconTA name="shield" size={24} /><p>{practice.membership}</p></div></div>
    <figure class="profile-photo reveal"><img src="/images/doctor.webp" srcset="/images/doctor-480.webp 480w, /images/doctor-960.webp 960w, /images/doctor-1600.webp 1600w" sizes="(max-width:760px) 88vw, 40vw" width="720" height="900" alt="Dr. Ricardo Orozco, odontólogo en Pereira" fetchpriority="high" /><figcaption><span>DR. RICARDO OROZCO</span><p>Rehabilitación Oral Integral</p></figcaption></figure>
  </section>
  <section class="education-section section-shell" aria-label="Formación académica"><ActionHeaderTA level="h2" eyebrow="FORMACIÓN ACADÉMICA" title="Una base para cuidar de ti." description="Formación en odontología y rehabilitación oral integral." /><div class="education-grid">{education.map((item) => <article class="education-card reveal"><span class="education-year">{item.year}</span><div><p>{item.city}</p><h3>{item.title}</h3><span>{item.institution}</span></div><IconTA name="arrow" size={23} /></article>)}</div></section>
  <section class="published-figures section-shell" aria-labelledby="published-figures-title">
    <div class="figures-heading reveal"><p class="eyebrow">INFORMACIÓN DEL CONSULTORIO</p><h2 id="published-figures-title">Cifras publicadas por el consultorio.</h2></div>
    <dl class="figures-grid">{publishedFigures.map((figure) => <div class="published-figure reveal"><dt>{figure.label}</dt><dd>{figure.value}</dd></div>)}</dl>
    <div class="figures-source"><p>Información publicada por el consultorio.</p><a href="https://www.odontologoricardoorozco.com/hoja-de-vida" target="_blank" rel="noreferrer">Datos publicados en el sitio original <IconTA name="arrow" size={15} /></a></div>
  </section>
  <section class="continuing-section section-shell"><div class="continuing-heading"><ActionHeaderTA level="h2" eyebrow="FORMACIÓN COMPLEMENTARIA" title="Aprender. Profundizar. Aplicar." /><p>Cursos, encuentros académicos y congresos que forman parte de su trayectoria.</p></div><ol class="studies-list">{studies.map((item) => <li class="study-item reveal"><span class="study-date">{item.date}</span><div><h3>{item.title}</h3><p>{item.detail}</p></div><span class="study-marker" aria-hidden="true"><IconTA name="plus" size={15} /></span></li>)}</ol></section>
  <ContactBandTA />
</PageLayoutTA>
<style>
  .profile-hero{display:grid;grid-template-columns:1.05fr 1fr;align-items:center;gap:9%;padding-block:75px 90px}.profile-copy h1{font-size:clamp(40px,4.7vw,68px);line-height:1.09;letter-spacing:-2.8px;font-weight:600;margin:24px 0 28px;color:#193f50}.profile-copy h1 span{color:#6c8c9c}.profile-intro{font-size:22px;font-weight:600;margin-bottom:8px;color:#193f50}.profile-role{font-size:15px;line-height:1.7;max-width:390px;color:#5d7480}.profile-copy>p:last-of-type{font-size:15px;line-height:1.85;color:#5f7480;max-width:430px;margin:23px 0 28px}.profile-copy .button{font-size:13px}.membership{display:flex;align-items:center;gap:13px;border-top:1px solid #dce4e6;padding-top:24px;margin-top:35px;max-width:400px}.membership>svg{color:#6395b7;flex-shrink:0}.membership p{font-size:12px;line-height:1.7;color:#5f7480;max-width:290px}.profile-photo{position:relative;margin:0;height:585px;overflow:hidden;background:#e9f0f2;border-radius:12px 115px 12px 12px}.profile-photo>img{height:100%;width:100%;object-fit:cover;object-position:50% 28%}.profile-photo:after{content:"";position:absolute;inset:50% 0 0;background:linear-gradient(transparent,#193f5075)}.profile-photo figcaption{position:absolute;left:30px;right:30px;bottom:26px;color:#fff;z-index:1}.profile-photo figcaption>span{font-size:10px;letter-spacing:.13em}.profile-photo figcaption>p{font-size:14px;margin-top:8px}.education-section{padding-block:65px 80px;border-top:1px solid #dce4e6}.education-grid{display:grid;grid-template-columns:1fr 1fr;gap:22px;margin-top:37px}.education-card{position:relative;padding:32px;background:#f0f5f6;border:1px solid #e2e9eb;border-radius:10px;min-height:240px;display:flex;gap:25px;align-items:flex-start}.education-year{font-size:36px;color:#608399;letter-spacing:-1.8px;line-height:1.1;font-weight:400}.education-card>div>p{font-size:12px;color:#5f7480;margin-bottom:13px}.education-card h3{font-size:21px;font-weight:500;line-height:1.35;margin:0 0 14px;color:#193f50;max-width:250px;letter-spacing:-.6px}.education-card>div>span{font-size:13px;line-height:1.7;color:#5f7480}.education-card>svg{position:absolute;right:24px;bottom:24px;color:#73a7c8}.continuing-section{padding-block:70px 90px}.continuing-heading{display:grid;grid-template-columns:1.2fr 1fr;gap:12%;align-items:end}.continuing-heading>p{font-size:14px;line-height:1.8;color:#5f7480;max-width:320px;margin-bottom:8px}.studies-list{list-style:none;padding:0;margin:38px 0 0;border-top:1px solid #dce4e6}.study-item{display:grid;grid-template-columns:210px 1fr 20px;gap:28px;padding:26px 0;border-bottom:1px solid #dce4e6}.study-date{font-size:12px;line-height:1.8;color:#5f7480;padding-top:2px}.study-item h3{font-size:16px;font-weight:500;line-height:1.5;color:#193f50;margin:0 0 8px}.study-item p{font-size:13px;line-height:1.85;color:#5f7480;max-width:690px}.study-marker{color:#82acc6;padding-top:5px}
  @media(max-width:900px){.profile-hero{gap:6%;padding-block:50px 65px}.profile-photo{height:510px}.profile-copy h1{font-size:44px;letter-spacing:-1.8px}.profile-intro{font-size:20px}.profile-role,.profile-copy>p:last-of-type{font-size:13px}.profile-copy .button{font-size:11px}.education-card{padding:25px;gap:20px}.education-year{font-size:31px}.education-card h3{font-size:18px}.education-card>div>span{font-size:12px}.study-item{grid-template-columns:170px 1fr 18px;gap:20px}.continuing-heading{gap:7%}.continuing-heading>p{font-size:13px}}
  @media(max-width:650px){.profile-hero{grid-template-columns:1fr;gap:35px;padding-block:42px 55px}.profile-copy h1{font-size:43px;letter-spacing:-1.8px;margin-top:20px}.profile-intro{font-size:21px}.profile-role,.profile-copy>p:last-of-type{font-size:14px}.profile-copy .button{font-size:12px}.membership{margin-top:28px;padding-top:21px}.membership p{font-size:12px}.profile-photo{height:470px;border-top-right-radius:90px}.profile-photo figcaption{left:24px;bottom:24px}.education-section{padding-block:48px 55px}.education-grid{grid-template-columns:1fr;margin-top:28px;gap:17px}.education-card{padding:27px;min-height:190px;gap:25px}.education-year{font-size:35px}.education-card h3{font-size:20px}.education-card>div>span{font-size:13px}.continuing-section{padding-block:45px 60px}.continuing-heading{grid-template-columns:1fr;gap:19px}.continuing-heading>p{font-size:14px;max-width:none}.study-item{grid-template-columns:1fr 18px;gap:12px;padding:24px 0}.study-date{grid-column:1;font-size:12px}.study-item>div{grid-row:2;grid-column:1}.study-marker{grid-column:2;grid-row:1}.study-item h3{font-size:16px}.study-item p{font-size:13px}.studies-list{margin-top:28px}}
  .published-figures { padding-block: 48px 58px; border-top: 1px solid #dce4e6; border-bottom: 1px solid #dce4e6; }
  .figures-heading h2 { color: #193f50; font-size: 30px; font-weight: 500; line-height: 1.35; letter-spacing: -.8px; margin: 17px 0 0; }
  .figures-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 30px; margin: 34px 0 29px; }
  .published-figure { display: flex; flex-direction: column-reverse; gap: 13px; min-width: 0; padding-top: 22px; border-top: 1px solid #dce4e6; }
  .published-figure dt { font-size: 13px; color: #5f7480; line-height: 1.65; }
  .published-figure dd { font-size: 46px; line-height: 1.1; letter-spacing: -2px; font-weight: 400; color: #193f50; margin: 0; }
  .figures-source { display: flex; justify-content: space-between; align-items: flex-start; gap: 30px; }
  .figures-source p { font-size: 12px; line-height: 1.8; color: #5f7480; max-width: 580px; }
  .figures-source a { display: inline-flex; align-items: center; gap: 10px; color: #436f87; font-size: 12px; line-height: 1.8; text-decoration: underline; text-underline-offset: 4px; }
  .figures-source a svg { flex-shrink: 0; }
  @media (max-width: 800px) { .figures-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 27px; } .figures-source { flex-direction: column; gap: 15px; } }
  @media (max-width: 650px) { .published-figures { padding-block: 40px 45px; } .figures-heading h2 { font-size: 28px; } .figures-grid { margin-top: 28px; gap: 26px 20px; } .published-figure dd { font-size: 41px; } .published-figure dt { font-size: 12px; } }
</style>

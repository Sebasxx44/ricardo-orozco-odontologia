---
import PageLayoutTA from "@/components/PageLayoutTA.astro";
import ActionHeaderTA from "@/components/ActionHeaderTA.astro";
import ContactBandTA from "@/components/ContactBandTA.astro";
import FaqTA from "@/components/FaqTA.astro";
import IconTA from "@/components/IconTA.astro";
import { services } from "@/data/practice";
---
<PageLayoutTA title="Servicios odontológicos en Pereira" description="Implantes, calzas blancas, diseño de sonrisa, rehabilitación oral, aclaramiento dental y ortodoncia. Conoce la atención del Dr. Ricardo Orozco en Pereira." active="servicios">
  <section class="services-hero section-shell"><div class="services-copy reveal"><p class="eyebrow">SERVICIOS ODONTOLÓGICOS</p><h1>El primer paso:<br /><span>entender lo que necesitas.</span></h1><p>Una atención personalizada, con tiempo para explicarte cada procedimiento y plantear un tratamiento acorde contigo.</p><a class="button button-dark" href="/contacto">Solicitar una valoración <IconTA name="arrow" size={18} /></a></div><figure class="services-photo reveal"><img src="/images/clinic.webp" srcset="/images/clinic-480.webp 480w, /images/clinic-960.webp 960w, /images/clinic-1600.webp 1600w" sizes="(max-width:650px) 88vw, 43vw" width="960" height="720" alt="Espacio de atención del consultorio odontológico" fetchpriority="high" /><figcaption><IconTA name="heart" size={18} /><span>Escuchar. Explicar. Cuidar.</span></figcaption></figure></section>
  <section class="treatments-section section-shell"><ActionHeaderTA level="h2" eyebrow="UN PLAN ACORDE CON CADA PERSONA" title="Opciones para tu salud oral." description="La valoración permite conocer la indicación y el alcance de cada tratamiento." /><div class="treatment-grid">{services.map((service, index) => <article class="treatment-card reveal" id={service.id}><div class="treatment-top"><span class="treatment-icon"><IconTA name={service.icon} size={28} /></span><span>0{index + 1}</span></div><h3>{service.title}</h3><p>{service.description}</p><a href={`/contacto?servicio=${service.id}`} class="treatment-link">Consultar este tratamiento <IconTA name="arrow" size={18} /></a></article>)}</div></section>
  <section class="care-process section-shell"><div class="process-heading"><ActionHeaderTA level="h2" eyebrow="ASÍ EMPIEZA TU ATENCIÓN" title="Primero, una conversación." /><p>Cada procedimiento parte de una explicación clara y de las necesidades de tu salud oral.</p></div><div class="process-grid"><article><span>01</span><h3>Te escuchamos</h3><p>Conocemos el motivo de tu consulta y lo que te gustaría resolver.</p></article><article><span>02</span><h3>Valoramos tu caso</h3><p>La revisión clínica orienta las opciones que pueden ser adecuadas para ti.</p></article><article><span>03</span><h3>Lo hablamos contigo</h3><p>Explicamos el procedimiento propuesto para que puedas consultar tus dudas.</p></article></div></section>
  <FaqTA />
  <ContactBandTA />
</PageLayoutTA>
<style>
  .services-hero{display:grid;grid-template-columns:1.1fr 1fr;align-items:center;gap:8%;padding-block:70px 80px}.services-copy h1{font-size:clamp(38px,4.6vw,65px);line-height:1.13;letter-spacing:-2.4px;font-weight:600;color:#193f50;margin:24px 0}.services-copy h1 span{color:#7d9aa8}.services-copy>p:not(.eyebrow){font-size:15px;line-height:1.85;color:#5f7480;max-width:430px;margin-bottom:30px}.services-copy .button{font-size:13px}.services-photo{position:relative;margin:0;overflow:hidden;border-radius:12px;height:390px;background:#eaf1f4}.services-photo img{height:100%;width:100%;object-fit:cover}.services-photo figcaption{position:absolute;left:22px;right:22px;bottom:20px;display:flex;align-items:center;gap:11px;background:#ffffffed;border-radius:8px;padding:16px 19px;font-size:13px;color:#193f50;backdrop-filter:blur(12px)}.services-photo figcaption>svg{color:#7bafd3}.treatments-section{padding-block:60px 80px;border-top:1px solid #dce5e8}.treatment-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:23px;margin-top:37px}.treatment-card{display:flex;flex-direction:column;padding:28px;border:1px solid #e0e8eb;border-radius:10px;background:#f6f8f8;min-height:340px;scroll-margin-top:100px}.treatment-top{display:flex;align-items:center;justify-content:space-between}.treatment-top>span:last-child{font-size:11px;color:#a5b5bb}.treatment-icon{height:54px;width:54px;border-radius:12px;background:#e7eff4;color:#6d9fbc;display:grid;place-items:center}.treatment-card:nth-child(3n+2) .treatment-icon{background:#ecf2dc;color:#7b925a}.treatment-card h3{font-size:22px;letter-spacing:-.6px;line-height:1.3;font-weight:500;color:#193f50;margin:26px 0 16px}.treatment-card>p{font-size:13px;line-height:1.85;color:#5f7480;flex:1}.treatment-link{display:flex;align-items:center;justify-content:space-between;gap:15px;padding-top:22px;margin-top:23px;border-top:1px solid #e0e7ea;font-size:12px;color:#456d83}.treatment-link svg{transition:transform .2s}.treatment-link:hover svg{transform:translateX(3px)}.care-process{padding-block:65px 80px}.process-heading{display:grid;grid-template-columns:1.2fr 1fr;gap:12%;align-items:end}.process-heading>p{font-size:14px;line-height:1.85;color:#5f7480;max-width:350px;margin-bottom:9px}.process-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:40px;margin-top:40px}.process-grid article{padding-top:25px;border-top:1px solid #dbe5e9}.process-grid article>span{color:#82b0cd;font-size:14px;display:block;margin-bottom:22px}.process-grid h3{font-size:19px;font-weight:500;letter-spacing:-.3px;color:#193f50;margin:0 0 14px}.process-grid p{font-size:14px;line-height:1.85;color:#5f7480;max-width:310px}
  @media(max-width:950px){.services-hero{gap:6%;padding-block:50px 65px}.services-copy h1{font-size:43px;letter-spacing:-1.7px}.services-copy>p:not(.eyebrow){font-size:14px}.services-photo{height:370px}.treatment-grid{grid-template-columns:repeat(2,1fr);gap:20px}.treatment-card{min-height:320px}.process-heading{gap:7%}.process-grid{gap:27px}.process-grid p{font-size:13px}}
  @media(max-width:650px){.services-hero{grid-template-columns:1fr;gap:33px;padding-block:42px 55px}.services-copy h1{font-size:42px;letter-spacing:-1.7px;margin-block:21px}.services-copy>p:not(.eyebrow){font-size:15px}.services-copy .button{font-size:13px}.services-photo{height:320px}.services-photo figcaption{left:17px;right:17px;bottom:17px;font-size:12px;padding:14px 16px}.treatments-section{padding-block:48px 55px}.treatment-grid{grid-template-columns:1fr;margin-top:28px;gap:18px}.treatment-card{min-height:315px;padding:26px}.treatment-card h3{font-size:24px}.treatment-card>p{font-size:14px}.treatment-link{font-size:13px}.care-process{padding-block:45px 60px}.process-heading{grid-template-columns:1fr;gap:20px}.process-heading>p{font-size:14px;max-width:none}.process-grid{grid-template-columns:1fr;gap:27px;margin-top:30px}.process-grid article{padding-top:23px}.process-grid article>span{margin-bottom:17px}.process-grid h3{font-size:21px}.process-grid p{font-size:14px;max-width:none}}
  @media(prefers-reduced-motion:reduce){.treatment-link svg{transition:none}}
</style>

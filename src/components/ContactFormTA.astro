---
import IconTA from "@/components/IconTA.astro";
import { practice, services } from "@/data/practice";
---
<div class="contact-form-card">
  <div class="form-heading"><p class="eyebrow">UN PRIMER PASO, SIN AFÁN.</p><h2>Cuéntanos qué necesitas.</h2><p>Prepara tu solicitud y revísala antes de continuar en WhatsApp.</p></div>
  <form id="contact-form" data-whatsapp={practice.whatsapp}>
    <div class="form-field"><label for="name">Nombre completo <span>*</span></label><input id="name" name="name" type="text" autocomplete="name" minlength="2" maxlength="100" required placeholder="Tu nombre" /></div>
    <div class="form-row"><div class="form-field"><label for="email">Correo electrónico <span>*</span></label><input id="email" name="email" type="email" autocomplete="email" maxlength="160" required placeholder="nombre@correo.com" /></div><div class="form-field"><label for="phone">Teléfono <span>*</span></label><input id="phone" name="phone" type="tel" inputmode="tel" autocomplete="tel" minlength="7" maxlength="25" required placeholder="Tu número de contacto" /></div></div>
    <div class="form-field"><label for="service">Servicio de interés <span>*</span></label><select id="service" name="service" required><option value="" disabled selected>Selecciona un servicio</option>{services.map((service) => <option value={service.id}>{service.title}</option>)}</select></div>
    <div class="form-field"><label for="message">¿En qué podemos orientarte? <span class="optional-field">Opcional</span></label><textarea id="message" name="message" rows="4" maxlength="1200" placeholder="Escribe el motivo de tu solicitud"></textarea></div>
    <label class="consent-label"><input id="consent" name="consent" type="checkbox" required /><span>Entiendo que, al continuar en WhatsApp, se abrirá una solicitud con mis datos para enviarla al consultorio. El mensaje no se envía automáticamente.</span></label>
    <button class="button button-blue prepare-button" type="submit" data-contact-submit disabled>Preparar solicitud <IconTA name="arrow" size={18} /></button>
    <noscript><p class="form-note">Para preparar y revisar la solicitud necesitas activar JavaScript. También puedes <a href={`https://wa.me/${practice.whatsapp}`} target="_blank" rel="noreferrer">contactar al consultorio por WhatsApp</a>.</p></noscript>
    <p class="form-note">La cita y la disponibilidad se confirman directamente con el consultorio.</p>
  </form>
  <div id="contact-review" class="contact-review" hidden><p class="eyebrow">REVISA TU SOLICITUD</p><h3>Antes de continuar.</h3><p id="contact-summary"></p><a id="contact-whatsapp" class="button button-dark" target="_blank" rel="noreferrer">Continuar en WhatsApp <IconTA name="whatsapp" size={19} /></a><button type="button" class="edit-request" data-edit-request>Editar solicitud</button><p class="review-note">WhatsApp se abrirá únicamente al pulsar el enlace. El envío final depende de ti.</p></div>
  <p id="contact-status" role="status" aria-live="polite" class="form-status"></p>
</div>
<style>
  .contact-form-card{background:#f5f8f9;border:1px solid #e1e9ec;border-radius:12px;padding:35px}.form-heading{padding-bottom:27px;margin-bottom:28px;border-bottom:1px solid #dde6ea}.form-heading h2{font-size:28px;font-weight:500;line-height:1.25;letter-spacing:-.8px;color:#193f50;margin:16px 0 13px}.form-heading>p:last-child{font-size:13px;line-height:1.8;color:#5f7480}.form-field{margin-bottom:23px;min-width:0}.form-field label{display:block;font-size:13px;font-weight:500;color:#365c6f;margin-bottom:10px}.form-field label>span{color:#83a4b7;margin-left:3px}.form-field label>.optional-field{color:#5f7480;font-size:12px;font-weight:400}.form-field input,.form-field select,.form-field textarea{display:block;width:100%;border:1px solid #d7e3e8;background:#fff;border-radius:6px;color:#193f50;font:inherit;font-size:14px;line-height:1.5;padding:13px 14px;min-width:0}.form-field input,.form-field select{min-height:48px}.form-field textarea{resize:vertical;min-height:120px}.form-field input::placeholder,.form-field textarea::placeholder{color:#5f7480;font-size:13px}.form-field input:focus,.form-field select:focus,.form-field textarea:focus{outline:2px solid #91bbd5;outline-offset:2px}.form-row{display:grid;grid-template-columns:1fr 1fr;gap:19px}.consent-label{display:flex;gap:12px;align-items:flex-start;margin:6px 0 27px;cursor:pointer}.consent-label input{height:17px;width:17px;margin:3px 0 0;accent-color:#578ab1;flex-shrink:0}.consent-label>span{font-size:12px;line-height:1.85;color:#5f7480}.prepare-button{width:100%;justify-content:space-between}.form-note{font-size:12px;line-height:1.8;color:#5f7480;margin-top:17px}.contact-review{background:#fff;border:1px solid #d9e5eb;border-radius:9px;padding:25px;margin-top:15px}.contact-review h3{font-size:25px;font-weight:500;color:#193f50;letter-spacing:-.6px;margin:15px 0 22px}#contact-summary{font-size:14px;line-height:1.9;color:#5f7480;white-space:pre-line;overflow-wrap:anywhere;margin-bottom:25px}.contact-review .button{width:100%;justify-content:space-between;font-size:13px}.edit-request{display:block;width:100%;margin:19px 0 0;padding:0;border:0;background:none;cursor:pointer;font:inherit;font-size:13px;color:#436f87;text-decoration:underline;text-underline-offset:4px}.review-note{font-size:12px;line-height:1.8;color:#5f7480;margin-top:21px}.form-status{font-size:13px;color:#436f87;line-height:1.8;margin-top:16px}.form-status:empty{margin:0}
  @media(max-width:900px){.contact-form-card{padding:28px}.form-row{grid-template-columns:1fr;gap:0}.form-heading h2{font-size:25px}.form-field{margin-bottom:22px}}
  @media(max-width:650px){.contact-form-card{padding:27px 22px}.form-heading h2{font-size:27px}.form-heading{padding-bottom:24px;margin-bottom:25px}.form-heading>p:last-child{font-size:13px}.form-field label{font-size:13px}.form-field input,.form-field select,.form-field textarea{font-size:16px;padding-inline:12px}.form-field input::placeholder,.form-field textarea::placeholder{font-size:13px}.consent-label>span{font-size:12px}.contact-review{padding:23px 18px}.contact-review h3{font-size:25px}.contact-review .button{font-size:12px}.review-note,.form-note{font-size:12px}}
</style>

---
import PageLayoutTA from '@/components/PageLayoutTA.astro';
import ActionHeaderTA from '@/components/ActionHeaderTA.astro';
import ContactBandTA from '@/components/ContactBandTA.astro';
import IconTA from '@/components/IconTA.astro';
import BlogCardTA from '@/components/blog/BlogCardTA.astro';
import BlogCoverTA from '@/components/blog/BlogCoverTA.astro';
import { articles, articleDate, articleReadingMinutes } from '@/data/articles';
import type { BlogArticle } from '@/types/blog';
interface Props { article: BlogArticle }
const { article } = Astro.props;
const index = articles.findIndex((entry) => entry.slug === article.slug);
const newer = index > 0 ? articles[index - 1] : null;
const older = index < articles.length - 1 ? articles[index + 1] : null;
const more = articles.filter((entry) => entry.slug !== article.slug).slice(0, 3);
const canonical = new URL(article.path, Astro.site);
const structuredData = {
  '@context': 'https://schema.org', '@type': 'BlogPosting', headline: article.title,
  description: article.excerpt, datePublished: article.publishedAt,
  author: {'@type': 'Person', name: 'Dr. Ricardo Orozco'},
  mainEntityOfPage: canonical.href, isBasedOn: article.sourceUrl, inLanguage: 'es-CO',
};
---
<PageLayoutTA title={article.title} description={article.excerpt} active="/blog">
  <Fragment slot="head"><meta property="article:published_time" content={article.publishedAt}/><meta property="article:section" content="Noticias"/><script type="application/ld+json" set:html={JSON.stringify(structuredData)}/></Fragment>
  <article class="blog-article">
    <header class="article-hero section-shell"><nav class="article-breadcrumb" aria-label="Ubicación del artículo"><a href="/blog">El diario de tu sonrisa</a><span aria-hidden="true">/</span><a href="/blog/c/new">Noticias</a></nav><div class="article-hero-grid"><div><ActionHeaderTA class="article-action-header" eyebrow={article.topic} title={article.title} description={article.excerpt}/><div class="article-byline"><span class="article-author-icon"><IconTA name="tooth" size={20}/></span><div><strong>Dr. Ricardo Orozco</strong><span><time datetime={article.date}>{articleDate(article.date)}</time><i aria-hidden="true">·</i>{articleReadingMinutes(article)} min de lectura</span></div></div></div><figure class="article-hero-image"><BlogCoverTA slug={article.slug} context="article"/><figcaption>DEL ARCHIVO DEL CONSULTORIO / {String(index + 1).padStart(2, '0')}</figcaption></figure></div></header>
    <div class="article-layout section-shell"><aside class="article-index" aria-labelledby="article-index-title"><p id="article-index-title" class="eyebrow">EN ESTA LECTURA</p><nav aria-label="Secciones del artículo"><ol>{article.sections.map((section, position) => <li><a href={`#${section.id}`}><span>{String(position + 1).padStart(2, '0')}</span>{section.heading}</a></li>)}</ol></nav><a class="article-ask" href="/contacto"><span>Tu caso merece<br/>su propia conversación.</span><IconTA name="arrow" size={19}/></a></aside><div class="article-body"><p class="article-editorial-note">Una edición en lenguaje claro del archivo del consultorio. Se conserva la fecha de publicación original.</p>{article.sections.map((section) => <section class="article-section" id={section.id} aria-labelledby={`${section.id}-title`}><h2 id={`${section.id}-title`}>{section.heading}</h2>{section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}</section>)}<div class="article-care-note"><IconTA name="heart" size={25}/><div><strong>Información para conversar, no para autodiagnosticarte.</strong><p>La valoración permite conocer tus necesidades, alternativas y cuidados. Tu historia y tus expectativas tienen espacio en la consulta.</p></div></div><section class="article-references" aria-labelledby="article-references-title"><h2 id="article-references-title">Para ampliar esta lectura</h2><p>Fuentes de asociaciones profesionales y organismos de salud que ayudan a poner el tema en contexto.</p><ul>{article.references.map((reference) => <li><a href={reference.url} target="_blank" rel="noopener noreferrer">{reference.title}<IconTA name="arrow" size={15}/></a></li>)}</ul></section><details class="article-original-media"><summary>Imagen del archivo original</summary><p>La pieza publicada originalmente se conserva como material del archivo; las portadas de esta edición son ilustraciones vectoriales.</p><a href={article.image} target="_blank" rel="noopener noreferrer">Consultar la imagen original <IconTA name="arrow" size={14}/></a></details><div class="article-tags" aria-label="Temas de esta lectura"><span>{article.topic}</span><a href="/blog/c/new">Noticias</a></div></div></div>
    <nav class="article-chronology section-shell" aria-label="Más artículos del archivo">{newer ? <a href={newer.path}><span>UNA LECTURA MÁS RECIENTE</span><strong>{newer.title}</strong><IconTA name="arrow" size={18}/></a> : <a href="/blog"><span>UN ARCHIVO PARA EXPLORAR</span><strong>Volver a todas las lecturas</strong><IconTA name="arrow" size={18}/></a>}{older && <a href={older.path}><span>SIGUE RECORRIENDO EL ARCHIVO</span><strong>{older.title}</strong><IconTA name="arrow" size={18}/></a>}</nav>
  </article>
  <section class="article-more section-shell" aria-labelledby="article-more-title"><div><p class="eyebrow">SIGAMOS CONVERSANDO</p><h2 id="article-more-title">Una pregunta lleva a otra.</h2><a class="text-link" href="/blog">Ver todo el blog <IconTA name="arrow" size={17}/></a></div><div class="article-more-grid">{more.map((entry, position) => <BlogCardTA article={entry} index={position}/>)}</div></section>
  <ContactBandTA/>
</PageLayoutTA>
<style>
.article-hero{padding-top:45px;padding-bottom:48px}.article-breadcrumb{display:flex;align-items:center;gap:13px;font-size:12px;color:#65808b;margin-bottom:40px}.article-breadcrumb>a:hover{color:#193f50}.article-breadcrumb>span{opacity:.5}.article-hero :global(.article-action-header){padding:0;max-width:none}.article-hero :global(.article-action-header .eyebrow>span){display:none}.article-hero-grid{display:grid;grid-template-columns:1.25fr 1fr;gap:7%;align-items:center}.article-hero :global(.article-action-header .eyebrow){font-size:10px;margin:0 0 20px;letter-spacing:1.4px}.article-hero :global(.article-action-header h1){font-size:clamp(36px,4vw,59px);font-weight:500;line-height:1.07;text-wrap:wrap;letter-spacing:-2.5px;margin:0 0 23px;max-width:750px}.article-hero :global(.article-action-header .action-description){font-size:15px;line-height:1.85;max-width:600px;color:#617d89;margin:0 0 26px}.article-byline{display:flex;align-items:center;gap:13px}.article-author-icon{width:43px;height:43px;border-radius:50%;background:#e6eddd;display:grid;place-items:center}.article-byline strong{display:block;font-size:12px;font-weight:600;margin-bottom:6px}.article-byline>div>span{display:flex;align-items:center;gap:9px;font-size:11px;color:#6f858d}.article-byline i{font-style:normal}.article-hero-image{margin:0;position:relative;height:360px;overflow:hidden;background:#e4edeb;border-radius:10px}.article-hero-image :global(.blog-cover){width:100%;height:100%;display:block}.article-hero-image>figcaption{position:absolute;left:20px;bottom:19px;border-radius:20px;background:#f7f8f2ed;padding:9px 12px;font-size:8px;letter-spacing:1px}.article-layout{display:grid;grid-template-columns:235px minmax(0,1fr);gap:9%;padding-top:35px;padding-bottom:65px;border-top:1px solid #193f501c}.article-index{position:sticky;top:120px;align-self:start}.article-index>.eyebrow{font-size:9px;letter-spacing:1.3px;margin-bottom:23px}.article-index ol{list-style:none;margin:0;padding:0}.article-index li{border-top:1px solid #193f501a}.article-index li:last-child{border-bottom:1px solid #193f501a}.article-index li a{display:flex;align-items:baseline;gap:12px;padding:14px 0;font-size:12px;line-height:1.6;color:#597581}.article-index li a>span{font-size:9px;color:#89a3ae;flex-shrink:0}.article-index li a:hover{color:#193f50}.article-ask{display:flex;align-items:center;justify-content:space-between;gap:20px;font-size:13px;line-height:1.6;margin-top:30px;padding:21px 17px;background:#e6eddd;border-radius:6px}.article-body{max-width:770px}.article-editorial-note{font-size:11px;line-height:1.8;color:#7b8f96;margin:0 0 28px}.article-section{scroll-margin-top:110px;margin-bottom:32px}.article-section>h2{font-size:27px;line-height:1.25;letter-spacing:-1px;font-weight:600;margin:0 0 14px}.article-section>p{font-size:16px;line-height:1.95;color:#4c6c7b;margin:0 0 18px}.article-care-note{display:flex;align-items:flex-start;gap:18px;background:#eaf2f5;border-left:2px solid #77afe0;padding:25px;margin-top:40px}.article-care-note>svg{flex-shrink:0;margin-top:2px}.article-care-note strong{font-size:14px;line-height:1.6;font-weight:600}.article-care-note p{font-size:13px;line-height:1.9;color:#5c7986;margin:10px 0 0}.article-references{margin-top:38px;padding-top:28px;border-top:1px solid #193f501c}.article-references h2{font-size:20px;font-weight:600;letter-spacing:-.5px;margin:0 0 12px}.article-references>p{color:#6f858e;font-size:12px;line-height:1.8;margin:0 0 18px}.article-references ul{list-style:none;margin:0;padding:0}.article-references li{margin-top:13px}.article-references li a{display:flex;align-items:center;justify-content:space-between;gap:18px;font-size:12px;line-height:1.7;color:#346c94}.article-references li a>svg{flex-shrink:0}.article-original-media{margin-top:25px;border-top:1px solid #193f501c;padding-top:18px;color:#6f858e}.article-original-media summary{cursor:pointer;font-size:12px}.article-original-media p{font-size:12px;line-height:1.8;margin-top:12px}.article-original-media a{display:inline-flex;align-items:center;gap:15px;color:#346c94;font-size:12px;margin-top:12px}.article-tags{display:flex;gap:9px;margin-top:30px;flex-wrap:wrap}.article-tags>*{padding:7px 12px;border:1px solid #193f5020;border-radius:20px;font-size:10px;color:#6f858e}.article-chronology{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:50px;border-block:1px solid #193f501c;padding-block:28px}.article-chronology>a{display:grid;grid-template-columns:1fr 25px;gap:11px 20px}.article-chronology>a>span{grid-column:1/-1;font-size:8px;letter-spacing:1.2px;color:#7b8f96}.article-chronology>a>strong{font-size:14px;line-height:1.6;font-weight:500;max-width:400px}.article-chronology>a>svg{align-self:center;justify-self:end}.article-chronology>a:hover>strong{color:#346c94}.article-more{padding-top:75px;padding-bottom:75px}.article-more>div:first-child{position:relative;margin-bottom:35px}.article-more .eyebrow{font-size:9px;margin-bottom:19px}.article-more h2{font-size:37px;letter-spacing:-1.4px;font-weight:500;margin:0;max-width:670px}.article-more>div>.text-link{position:absolute;right:0;bottom:4px;display:flex;align-items:center;gap:20px;font-size:12px}.article-more-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:27px}@media(max-width:1000px){.article-hero-grid{gap:5%;grid-template-columns:1.2fr 1fr}.article-hero :global(.article-action-header h1){font-size:42px;letter-spacing:-1.7px}.article-hero-image{height:330px}.article-hero :global(.article-action-header .action-description){font-size:14px}.article-layout{grid-template-columns:190px minmax(0,1fr);gap:6%}.article-section>h2{font-size:25px}.article-section>p{font-size:15px}.article-more h2{font-size:31px;max-width:480px}.article-more>div>.text-link{position:static;margin-top:20px}.article-more-grid{gap:20px}.article-more-grid :global(.blog-card h2){font-size:20px}}@media(max-width:700px){.article-hero{padding-top:30px;padding-bottom:30px}.article-breadcrumb{font-size:10px;gap:10px;margin-bottom:29px}.article-hero-grid{grid-template-columns:1fr;gap:30px}.article-hero :global(.article-action-header .eyebrow){font-size:9px;margin-bottom:17px}.article-hero :global(.article-action-header h1){font-size:37px;letter-spacing:-1.6px;max-width:540px;margin-bottom:20px}.article-hero :global(.article-action-header .action-description){font-size:14px;max-width:480px}.article-byline strong{font-size:12px}.article-byline>div>span{font-size:10px}.article-author-icon{width:40px;height:40px}.article-hero-image{height:290px}.article-hero-image>figcaption{font-size:7px;left:17px;bottom:17px}.article-layout{grid-template-columns:1fr;gap:30px;padding-top:27px;padding-bottom:45px}.article-index{position:static}.article-index>.eyebrow{margin-bottom:17px;font-size:8px}.article-index ol{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:0 20px}.article-index li a{font-size:11px;gap:9px;padding:12px 0}.article-index li:nth-last-child(2){border-bottom:1px solid #193f501a}.article-ask{display:none}.article-editorial-note{font-size:10px;margin-bottom:27px;max-width:420px}.article-section{margin-bottom:28px;scroll-margin-top:95px}.article-section>h2{font-size:25px;letter-spacing:-.7px}.article-section>p{font-size:15px;line-height:1.95}.article-care-note{padding:20px;gap:14px;margin-top:30px}.article-care-note>svg{width:22px;height:22px}.article-care-note strong{font-size:13px}.article-care-note p{font-size:12px}.article-references{margin-top:30px;padding-top:25px}.article-references h2{font-size:20px}.article-references>p{font-size:11px}.article-references li a{font-size:11px}.article-tags>*{font-size:9px}.article-chronology{grid-template-columns:1fr;gap:25px;padding-block:25px}.article-chronology>a+ a{border-top:1px solid #193f501c;padding-top:23px}.article-chronology>a>span{font-size:7px}.article-chronology>a>strong{font-size:13px}.article-more{padding-top:50px;padding-bottom:45px}.article-more .eyebrow{font-size:8px;margin-bottom:17px}.article-more h2{font-size:32px;max-width:370px}.article-more>div>.text-link{font-size:12px}.article-more-grid{grid-template-columns:1fr;gap:35px}.article-more-grid :global(.blog-card h2){font-size:23px}}
</style>

---
import ActionHeaderTA from '@/components/ActionHeaderTA.astro';
import ContactBandTA from '@/components/ContactBandTA.astro';
import IconTA from '@/components/IconTA.astro';
import BlogCardTA from '@/components/blog/BlogCardTA.astro';
import BlogCoverTA from '@/components/blog/BlogCoverTA.astro';
import { articles, articleDate } from '@/data/articles';
interface Props { page?: number; category?: boolean }
const { page = 1, category = false } = Astro.props;
const base = category ? '/blog/c/new' : '/blog';
const pages = Math.ceil(articles.length / 6);
const pagePath = (number: number): string => number === 1 ? base : `${base}/page/${number}`;
const featured = articles[0];
const first = (page - 1) * 6 + 1;
const last = Math.min(page * 6, articles.length);
---
<section class="blog-intro section-shell"><div class="blog-intro-top"><p class="eyebrow">SALUD ORAL, CON PALABRAS CLARAS.</p><a class="text-link" href="/prevencion-oral">Hábitos para cada día <IconTA name="arrow" size={15}/></a></div><ActionHeaderTA eyebrow={category ? 'ARCHIVO / NOTICIAS' : 'EL DIARIO DE TU SONRISA'} title="Conocer también es cuidarte." description="Ideas para entender tu salud oral, conversar sobre lo que sientes y tomar decisiones con más claridad."/><div class="blog-category"><a href="/blog" aria-current={!category ? 'page' : undefined}>Todos los artículos <span>17</span></a><a href="/blog/c/new" aria-current={category ? 'page' : undefined}>Noticias <span>17</span></a><span class="blog-archive-note">Lecturas del Dr. Ricardo Orozco</span></div></section>
{page === 1 && <section class="blog-feature section-shell reveal" aria-labelledby="blog-feature-title"><a href={featured.path} class="blog-feature-image" aria-label={`Leer: ${featured.title}`}><BlogCoverTA slug={featured.slug} context="feature"/><span class="blog-feature-label">PARA MIRAR DE CERCA</span></a><div class="blog-feature-copy"><p class="eyebrow">UNA LECTURA DESTACADA</p><div class="blog-feature-date"><span>{featured.topic}</span><time datetime={featured.date}>{articleDate(featured.date)}</time></div><h2 id="blog-feature-title"><a href={featured.path}>{featured.title}</a></h2><p>{featured.excerpt}</p><a class="button button-dark" href={featured.path}>Seguir leyendo <IconTA name="arrow" size={17}/></a></div></section>}
<section class="blog-library section-shell" id="articulos" aria-labelledby="blog-library-title" data-blog-archive data-blog-base={base} data-blog-initial-page={page}>
  <div class="blog-library-heading"><div><p class="eyebrow">UN ESPACIO PARA TUS PREGUNTAS</p><h2 id="blog-library-title" tabindex="-1">Todas las lecturas.</h2></div><form class="blog-search" role="search" data-blog-search-form hidden><label for="blog-query">Buscar por título o tema</label><div><IconTA name="tooth" size={18}/><input id="blog-query" data-blog-query type="search" placeholder="Ortodoncia, autoestima, estética…" autocomplete="off"/><button type="button" data-blog-clear aria-label="Borrar búsqueda" hidden><IconTA name="close" size={16}/></button></div></form></div>
  <div class="blog-results-line"><p data-blog-status role="status" aria-live="polite">Mostrando {first}–{last} de {articles.length} artículos</p><span>PUBLICADOS DE MAYO A OCTUBRE DE 2026</span></div>
  <div class="blog-grid">{articles.map((article, index) => <BlogCardTA article={article} index={index} page={page}/>)}</div>
  <div class="blog-empty" data-blog-empty hidden><IconTA name="smile" size={35}/><h3>Cambiemos la pregunta.</h3><p>No encontramos artículos con esa búsqueda. Prueba otra palabra o vuelve a todas las lecturas.</p><button class="button button-dark" type="button" data-blog-reset>Ver todos los artículos <IconTA name="arrow" size={16}/></button></div>
  <nav class="blog-pagination" aria-label="Páginas del blog" data-blog-pagination><a href={pagePath(Math.max(1, page - 1))} rel="prev" data-blog-direction="previous" aria-disabled={page === 1 ? 'true' : undefined} tabindex={page === 1 ? -1 : undefined}><span class="pagination-back"><IconTA name="arrow" size={17}/></span>Anterior</a><div>{Array.from({length:pages}, (_,index) => <a href={pagePath(index + 1)} data-blog-page={index + 1} aria-label={`Página ${index + 1}`} aria-current={page === index + 1 ? 'page' : undefined}>{index + 1}</a>)}</div><a href={pagePath(Math.min(pages, page + 1))} rel="next" data-blog-direction="next" aria-disabled={page === pages ? 'true' : undefined} tabindex={page === pages ? -1 : undefined}>Siguiente <IconTA name="arrow" size={17}/></a></nav>
  <noscript><p class="blog-no-script">Puedes recorrer los 17 artículos con los enlaces de paginación. La búsqueda por palabras se activa al permitir JavaScript.</p></noscript>
</section>
<ContactBandTA/>
<script>
import { initBlogArchive } from '@/composables/blog/initBlogArchive';
initBlogArchive();
</script>
<style>
.blog-intro{padding-top:65px}.blog-intro-top{display:flex;justify-content:space-between;align-items:center;gap:30px;margin-bottom:48px}.blog-intro-top>.eyebrow{font-size:10px;letter-spacing:1.5px}.blog-intro-top>.text-link{font-size:12px;display:flex;align-items:center;gap:15px}.blog-intro :global(.action-header){max-width:920px}.blog-intro :global(.action-header h1){max-width:850px}.blog-intro :global(.action-description){max-width:550px}.blog-category{display:flex;align-items:center;gap:12px;margin-top:35px;padding:24px 0;border-block:1px solid #193f501c}.blog-category>a{padding:10px 16px;border:1px solid transparent;border-radius:30px;font-size:12px;display:flex;align-items:center;gap:12px}.blog-category>a[aria-current]{border-color:#193f5033;background:#e8efdf}.blog-category>a>span{font-size:10px;opacity:.6}.blog-archive-note{margin-left:auto;font-size:11px;color:#6f858e}.blog-feature{display:grid;grid-template-columns:1.05fr 1fr;gap:7%;align-items:center;padding-block:48px 68px}.blog-feature-image{height:430px;position:relative;display:block;overflow:hidden;border-radius:12px;background:#e4edeb}.blog-feature-image :global(.blog-cover){width:100%;height:100%;display:block}.blog-feature-image:hover :global(.blog-cover){transform:scale(1.025)}.blog-feature-label{position:absolute;left:24px;bottom:24px;background:#f7f8f2e6;padding:10px 14px;border-radius:30px;font-size:9px;letter-spacing:1.3px}.blog-feature-copy>.eyebrow{font-size:10px;margin-bottom:24px}.blog-feature-date{display:flex;align-items:center;gap:16px;font-size:11px;color:#627e8b}.blog-feature-date>span{color:#356275}.blog-feature-copy h2{font-size:clamp(30px,3.2vw,47px);font-weight:500;line-height:1.12;letter-spacing:-1.8px;margin:18px 0 20px}.blog-feature-copy>p:not(.eyebrow){font-size:14px;line-height:1.9;color:#627e8b;max-width:420px;margin:0 0 26px}.blog-feature-copy>.button{font-size:12px}.blog-library{padding-top:35px;padding-bottom:90px}.blog-library-heading{display:flex;justify-content:space-between;align-items:flex-end;gap:40px;border-top:1px solid #193f501c;padding-top:40px}.blog-library-heading .eyebrow{font-size:9px;margin-bottom:15px}.blog-library-heading h2{font-size:38px;line-height:1.1;letter-spacing:-1.5px;font-weight:500;margin:0}.blog-search{width:310px;max-width:100%}.blog-search>label{display:block;color:#627e8b;font-size:11px;margin-bottom:10px}.blog-search>div{display:flex;align-items:center;gap:10px;border-bottom:1px solid #193f5050;padding:8px 0}.blog-search input{width:100%;min-width:0;border:0;background:transparent;color:#193f50;font:inherit;font-size:12px;padding:6px 0}.blog-search button{background:transparent;border:0;color:#193f50;cursor:pointer;padding:4px}.blog-search input::-webkit-search-cancel-button{-webkit-appearance:none}.blog-search[hidden],.blog-empty[hidden],.blog-pagination[hidden]{display:none!important}.blog-results-line{display:flex;align-items:center;justify-content:space-between;gap:25px;margin:27px 0 32px;color:#6f858e;font-size:10px}.blog-results-line>p{margin:0}.blog-results-line>span{font-size:8px;letter-spacing:1px}.blog-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:50px 26px}.blog-empty{padding:65px 20px;text-align:center}.blog-empty>svg{margin:auto}.blog-empty h3{font-size:30px;font-weight:500;letter-spacing:-1px;margin:22px 0 12px}.blog-empty>p{color:#627e8b;font-size:13px;line-height:1.8;max-width:450px;margin:0 auto 25px}.blog-empty>.button{font-size:12px}.blog-pagination{display:flex;align-items:center;justify-content:space-between;gap:25px;border-top:1px solid #193f501c;padding-top:30px;margin-top:50px}.blog-pagination>a{display:flex;align-items:center;gap:13px;font-size:12px}.blog-pagination>a[aria-disabled=true]{opacity:.35;pointer-events:none}.pagination-back{display:block;transform:rotate(180deg)}.blog-pagination>div{display:flex;gap:7px}.blog-pagination>div>a{width:37px;height:37px;border:1px solid transparent;border-radius:50%;display:grid;place-items:center;font-size:12px}.blog-pagination>div>a[aria-current]{background:#193f50;color:#f7f8f2}.blog-pagination>div>a:hover{border-color:#193f5030}.blog-no-script{font-size:12px;line-height:1.8;color:#627e8b;margin-top:25px}@media(max-width:950px){.blog-feature{gap:5%;padding-bottom:50px}.blog-feature-image{height:380px}.blog-feature-copy h2{font-size:35px}.blog-feature-copy>p:not(.eyebrow){font-size:13px}.blog-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:40px 25px}.blog-library-heading h2{font-size:33px}.blog-search{width:270px}.blog-archive-note{font-size:10px}}@media(max-width:650px){.blog-intro{padding-top:35px}.blog-intro-top{margin-bottom:32px;gap:15px}.blog-intro-top>.eyebrow{font-size:8px;letter-spacing:.8px}.blog-intro-top>.text-link{font-size:10px;gap:8px;white-space:nowrap}.blog-category{gap:5px;flex-wrap:wrap;margin-top:27px;padding:17px 0}.blog-category>a{font-size:11px;padding:9px 12px}.blog-archive-note{flex-basis:100%;margin:10px 0 0;padding-left:12px;font-size:10px}.blog-feature{grid-template-columns:1fr;gap:27px;padding-block:32px 45px}.blog-feature-image{height:310px}.blog-feature-label{font-size:8px;left:18px;bottom:18px}.blog-feature-copy>.eyebrow{font-size:9px;margin-bottom:18px}.blog-feature-date{font-size:10px;gap:13px}.blog-feature-copy h2{font-size:35px;letter-spacing:-1.5px;max-width:420px;margin:17px 0}.blog-feature-copy>p:not(.eyebrow){font-size:13px;max-width:400px;margin-bottom:22px}.blog-library{padding-top:15px;padding-bottom:55px}.blog-library-heading{display:block;padding-top:30px}.blog-library-heading h2{font-size:34px}.blog-library-heading .eyebrow{font-size:8px}.blog-search{margin-top:28px;width:100%}.blog-search>label{font-size:12px}.blog-search input{font-size:12px}.blog-results-line{margin:24px 0;gap:15px;font-size:9px}.blog-results-line>span{display:none}.blog-grid{grid-template-columns:1fr;gap:38px}.blog-pagination{gap:15px;padding-top:24px;margin-top:36px}.blog-pagination>a{font-size:12px;gap:7px}.blog-pagination>div{gap:3px}.blog-pagination>div>a{width:30px;height:30px;font-size:11px}.blog-empty{padding:45px 10px}.blog-empty h3{font-size:28px}.blog-empty>p{font-size:12px}}@media(prefers-reduced-motion:reduce){.blog-feature-image :global(.blog-cover){transition:none}.blog-feature-image:hover :global(.blog-cover){transform:none}}
</style>

---
import '@fontsource-variable/manrope';
import '@/styles/global.css';
import HeaderTA from '@/components/HeaderTA.astro';
import FooterTA from '@/components/FooterTA.astro';
interface Props { title: string; description: string; active: string }
const { title, description, active } = Astro.props;
const home = active === '/inicio' || active === 'inicio';
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html><html lang="es"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="theme-color" content="#77afe0"/><title>{title} · Dr. Ricardo Orozco</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/><link rel="icon" href="/favicon.svg" type="image/svg+xml"/><meta property="og:type" content="website"/><meta property="og:title" content={`${title} · Dr. Ricardo Orozco`}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:image" content={new URL('/images/clinic.webp', Astro.site)}/><meta name="twitter:card" content="summary_large_image"/><slot name="head"/></head><body class:list={[{ 'home-page': home }]}><a class="skip-link" href="#contenido">Saltar al contenido</a><div class="site-wrap"><HeaderTA active={active}/><main id="contenido" class:list={[{ 'inner-page': !home }]}><slot/></main><FooterTA/></div><script>
import { initMotion } from '@/composables/motion/initMotion';
import { initNavigation } from '@/composables/navigation/initNavigation';
import { initContact } from '@/composables/contact/initContact';
initMotion();
initNavigation();
initContact();
</script></body></html>
